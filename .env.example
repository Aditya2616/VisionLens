# Everything below is optional. VisionLens runs fully offline with the defaults.

# Threads for torch and OpenCV (default: a quarter of the logical cores).
# VISIONLENS_THREADS=3

# Local describer model used by --describer llm (downloaded once by `visionlens fetch-models`).
# VISIONLENS_LLM=Qwen/Qwen2.5-0.5B-Instruct

# Hosted describers (optional adapters). Pick with --describer openai or --describer anthropic.
# OPENAI_API_KEY=
# OPENAI_MODEL=            # set this to the model id you want to use (there is no default)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=         # set this to the model id you want to use (there is no default)
